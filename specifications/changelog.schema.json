{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Журнал изменений",
  "description": "Структура файла <Имя>.changelog.json: schema-format.md, раздел 11.4. Порядок дат, пути target и новые записи проверяет tools/validate.py.",
  "type": "object",
  "required": ["$ref", "entries"],
  "properties": {
    "$ref": {
      "description": "Публичный контракт каталога (раздел 11.1, правило 2).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "entries": {
      "description": "Записи от новых к старым.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["date", "kind", "description"],
      "properties": {
        "date": {
          "description": "Дата записи, ISO 8601.",
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "issue": {
          "description": "Номер задачи; обязателен у новых записей (проверяет валидатор с --base).",
          "type": "integer",
          "minimum": 1
        },
        "kind": { "enum": ["added", "changed", "removed"] },
        "target": {
          "description": "Путь к свойству, варианту или значению через точку от публичного контракта; без него запись о сущности целиком.",
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
        },
        "description": {
          "description": "Для дизайнера, на русском; из разметки — только код в строке.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
