{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Контракт",
  "description": "Структура JSON-контракта: schema-format.md, разделы 3–8, 10. Связи между файлами проверяет tools/validate.py.",
  "type": "object",
  "required": ["name", "type", "description"],
  "properties": {
    "name": { "$ref": "#/$defs/pascalCaseName" },
    "type": { "enum": ["object", "enum", "oneOf"] },
    "description": { "$ref": "#/$defs/description" },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/property" }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/enumValue" }
    },
    "oneOf": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/oneOfItem" }
    },
    "extends": {
      "description": "Ссылка на базовую модель Component (раздел 5.2).",
      "allOf": [{ "$ref": "#/$defs/ref" }, { "const": "core/component/Component" }]
    },
    "appearanceContext": {
      "description": "Контекст оформления компонента (раздел 5.2).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["plain", "control", "selectable", "focusable"] }
    },
    "sample": { "$ref": "#/$defs/sample" },
    "releaseVersions": { "$ref": "#/$defs/releaseVersions" }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "extends": ["appearanceContext"],
    "appearanceContext": ["extends"]
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "object" } } },
      "then": {
        "allOf": [
          { "not": { "required": ["values"] } },
          { "not": { "required": ["oneOf"] } },
          { "not": { "required": ["sample"] } }
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "enum" } } },
      "then": {
        "required": ["values"],
        "allOf": [
          { "not": { "required": ["properties"] } },
          { "not": { "required": ["oneOf"] } },
          { "not": { "required": ["extends"] } },
          { "not": { "required": ["appearanceContext"] } }
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "oneOf" } } },
      "then": {
        "required": ["oneOf"],
        "allOf": [
          { "not": { "required": ["properties"] } },
          { "not": { "required": ["values"] } },
          { "not": { "required": ["extends"] } },
          { "not": { "required": ["appearanceContext"] } }
        ]
      }
    }
  ],
  "$defs": {
    "pascalCaseName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "lowerCamelCaseName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "description": { "type": "string", "minLength": 1 },
    "primitiveType": { "enum": ["string", "boolean", "integer", "float", "color", "payload"] },
    "sample": {
      "description": "Подсказка генератору образцов: значение по разделу 4.5; допустимость для типа проверяет tools/validate.py (раздел 11.1).",
      "not": { "type": "null" }
    },
    "ref": {
      "description": "Имя контракта в своей сущности или теме либо идентификатор <слой>/<сущность>/<Имя> (раздел 6).",
      "type": "string",
      "pattern": "^([a-z][A-Za-z0-9]*/[a-z][A-Za-z0-9]*/)?[A-Z][A-Za-z0-9]*$"
    },
    "property": {
      "description": "Свойство объекта (раздел 5).",
      "type": "object",
      "required": ["name", "required", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/lowerCamelCaseName" },
        "type": { "anyOf": [{ "$ref": "#/$defs/primitiveType" }, { "const": "array" }] },
        "$ref": { "$ref": "#/$defs/ref" },
        "description": { "$ref": "#/$defs/description" },
        "required": { "type": "boolean" },
        "items": { "$ref": "#/$defs/arrayItems" },
        "uniqueVariants": { "type": "boolean" },
        "defaultsTo": { "$ref": "#/$defs/lowerCamelCaseName" },
        "sample": { "$ref": "#/$defs/sample" },
        "releaseVersions": { "$ref": "#/$defs/releaseVersions" }
      },
      "additionalProperties": false,
      "dependentSchemas": {
        "defaultsTo": { "properties": { "required": { "const": false } } }
      },
      "oneOf": [{ "required": ["type"] }, { "required": ["$ref"] }],
      "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
      "then": { "required": ["items"] },
      "else": { "allOf": [{ "not": { "required": ["items"] } }, { "not": { "required": ["uniqueVariants"] } }] }
    },
    "arrayItems": {
      "description": "Тип элементов массива: примитивный тип или ссылка, без вложенных массивов (раздел 5.1).",
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/primitiveType" },
        "$ref": { "$ref": "#/$defs/ref" }
      },
      "additionalProperties": false,
      "oneOf": [{ "required": ["type"] }, { "required": ["$ref"] }]
    },
    "enumValue": {
      "description": "Значение перечисления (раздел 4.4).",
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/lowerCamelCaseName" },
        "description": { "$ref": "#/$defs/description" },
        "releaseVersions": { "$ref": "#/$defs/releaseVersions" }
      },
      "additionalProperties": false
    },
    "oneOfItem": {
      "description": "Элемент oneOf (раздел 7).",
      "type": "object",
      "properties": {
        "$ref": { "$ref": "#/$defs/ref" },
        "type": { "$ref": "#/$defs/primitiveType" },
        "inline": { "type": "boolean" },
        "name": { "$ref": "#/$defs/lowerCamelCaseName" },
        "sample": { "$ref": "#/$defs/sample" },
        "releaseVersions": { "$ref": "#/$defs/releaseVersions" }
      },
      "additionalProperties": false,
      "oneOf": [{ "required": ["$ref"] }, { "required": ["type"] }],
      "allOf": [
        {
          "if": { "required": ["type"] },
          "then": { "required": ["name"], "allOf": [{ "not": { "required": ["inline"] } }] },
          "else": { "not": { "required": ["sample"] } }
        },
        {
          "if": { "properties": { "inline": { "const": true } }, "required": ["inline"] },
          "then": { "allOf": [{ "not": { "required": ["name"] } }] }
        }
      ]
    },
    "status": { "enum": ["released", "notReleased", "willNotBeReleased"] },
    "versionedStatus": {
      "description": "Статус строкой или объектом с версией реализации (раздел 8.3).",
      "anyOf": [
        { "$ref": "#/$defs/status" },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" }
          },
          "additionalProperties": false
        }
      ]
    },
    "releaseVersions": {
      "description": "Поддержка на платформах (раздел 8).",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "android": { "$ref": "#/$defs/versionedStatus" },
        "ios": { "$ref": "#/$defs/versionedStatus" },
        "figma": { "$ref": "#/$defs/status" }
      },
      "additionalProperties": false
    }
  }
}
