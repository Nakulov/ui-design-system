{
  "Container": {
    "id": "id",
    "layout": {
      "width": {
        "sizing": {
          "fixed": {
            "custom": {
              "value": 1
            }
          }
        },
        "min": {
          "custom": {
            "value": 1
          }
        },
        "max": {
          "custom": {
            "value": 1
          }
        }
      },
      "height": {
        "sizing": {
          "fixed": {
            "custom": {
              "value": 1
            }
          }
        },
        "min": {
          "custom": {
            "value": 1
          }
        },
        "max": {
          "custom": {
            "value": 1
          }
        }
      },
      "position": {
        "pinned": {
          "horizontal": {
            "start": {
              "offset": {
                "custom": {
                  "value": 1
                }
              }
            }
          },
          "vertical": {
            "top": {
              "offset": {
                "custom": {
                  "value": 1
                }
              }
            }
          },
          "relativeTo": "edge"
        }
      }
    },
    "padding": {
      "symmetric": {
        "horizontal": {
          "custom": {
            "value": 1
          }
        },
        "vertical": {
          "custom": {
            "value": 1
          }
        }
      }
    },
    "appearance": {
      "plain": {
        "background": {
          "solid": "primary"
        },
        "shadow": {
          "custom": {
            "offsetX": 1,
            "offsetY": 1,
            "blur": 1,
            "spread": 1,
            "color": "#000000"
          }
        },
        "cornerRadius": "zero",
        "stroke": {
          "width": {
            "custom": {
              "value": 1
            }
          },
          "color": "primary"
        },
        "overlay": {
          "solid": "primary"
        },
        "clip": true
      }
    },
    "indicators": [
      {
        "anchor": "topStart",
        "content": {
          "Container": {
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "arrangement": {
              "horizontal": {
                "alignment": "top",
                "distribution": "spaceBetween"
              }
            }
          }
        },
        "gap": {
          "custom": {
            "value": 1
          }
        }
      }
    ],
    "events": [
      {
        "click": {
          "payload": {
            "action": "payload"
          }
        }
      }
    ],
    "arrangement": {
      "horizontal": {
        "alignment": "top",
        "distribution": {
          "packed": {
            "gap": {
              "custom": {
                "value": 1
              }
            },
            "position": "start"
          }
        }
      }
    },
    "children": [
      {
        "Container": {
          "layout": {
            "width": {
              "sizing": "hug"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "arrangement": {
            "horizontal": {
              "alignment": "top",
              "distribution": "spaceBetween"
            }
          }
        }
      }
    ]
  }
}
