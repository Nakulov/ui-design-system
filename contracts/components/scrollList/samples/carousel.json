{
  "ScrollList": {
    "id": "recommendations",
    "layout": {
      "width": {
        "sizing": "fill"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "all": "zero"
    },
    "appearance": {
      "plain": {
        "background": {
          "solid": "surface"
        }
      }
    },
    "events": [
      {
        "reachEnd": {
          "payload": {
            "action": "loadMoreProducts"
          }
        }
      }
    ],
