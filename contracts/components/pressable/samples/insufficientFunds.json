{
  "Pressable": {
    "id": "pay",
    "layout": {
      "width": {
        "sizing": "hug"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "symmetric": {
        "horizontal": "l",
        "vertical": "s"
      }
    },
    "appearance": {
      "control": {
        "default": {
          "background": {
            "solid": "primary"
          },
          "cornerRadius": "full"
        },
        "pressed": {
          "background": {
            "solid": "primary"
          },
          "cornerRadius": "full",
          "overlay": {
            "solid": "overlayPressed"
          }
        },
        "disabled": {
          "background": {
            "solid": "surface2"
          },
          "cornerRadius": "full"
        }
      }
    },
    "events": [
      {
        "click": {
          "payload": {
            "action": "pay"
          }
        }
      }
    ],
    "enabled": false,
    "states": {
      "default": {
        "Text": {
          "id": "label",
          "layout": {
            "width": {
              "sizing": "hug"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "content": {
            "plain": "Оплатить"
          },
          "typography": "labelLarge",
          "color": {
            "solid": "onPrimary"
          },
          "alignment": "center"
        }
      },
      "disabled": {
        "Text": {
          "id": "label",
          "layout": {
            "width": {
              "sizing": "hug"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "events": [
            {
              "click": {
                "payload": {
                  "action": "showFundsHint"
                }
              }
            }
          ],
          "content": {
            "plain": "Недостаточно средств"
          },
          "typography": "labelLarge",
          "color": {
            "solid": "onSurfaceMuted"
          },
          "alignment": "center"
        }
      }
    }
  }
}
