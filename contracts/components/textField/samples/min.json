{
  "TextField": {
    "layout": {
      "width": {
        "sizing": "hug"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "all": "m"
    },
    "appearance": {
      "focusable": {
        "default": {},
        "focused": {},
        "disabled": {}
      }
    },
    "typography": "bodyLarge",
    "color": {
      "default": {
        "solid": "onSurface"
      },
      "disabled": {
        "solid": "onSurfaceMuted"
      }
    },
    "alignment": "start",
    "cursorColor": "primary"
  }
}
