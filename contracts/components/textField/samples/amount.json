{
  "TextField": {
    "id": "amount",
    "layout": {
      "width": {
        "sizing": "fill"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "symmetric": {
        "horizontal": "m",
        "vertical": "s"
      }
    },
    "appearance": {
      "focusable": {
        "default": {
          "cornerRadius": "m",
          "stroke": {
            "width": "s",
            "color": "outline"
          }
        },
        "focused": {
          "cornerRadius": "m",
          "stroke": {
            "width": "m",
            "color": "primary"
          }
        },
        "disabled": {
          "background": {
            "solid": "surface2"
          },
          "cornerRadius": "m",
          "stroke": {
            "width": "s",
            "color": "outline"
          }
        }
      }
    },
    "events": [
      {
        "change": {
          "payload": {
            "action": "amountChanged"
          }
        }
      }
    ],
    "value": {
      "plain": "1 500"
    },
    "typography": "headlineSmall",
    "color": {
      "default": {
        "solid": "onSurface"
      },
      "disabled": {
        "solid": "onSurfaceMuted"
      }
    },
    "alignment": "end",
    "cursorColor": "primary",
    "placeholder": {
      "content": {
        "plain": "0"
      },
      "typography": "headlineSmall",
      "color": {
        "default": {
          "solid": "onSurfaceVariant"
        },
        "disabled": {
          "solid": "onSurfaceMuted"
        }
      }
    },
    "keyboard": {
      "type": "decimal",
      "returnKey": "done"
    },
    "trailing": {
      "content": {
        "default": {
          "Text": {
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "content": {
              "plain": "₽"
            },
            "typography": "headlineSmall",
            "color": {
              "solid": "onSurfaceVariant"
            },
            "alignment": "start"
          }
        },
        "disabled": {
          "Text": {
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "content": {
              "plain": "₽"
            },
            "typography": "headlineSmall",
            "color": {
              "solid": "onSurfaceMuted"
            },
            "alignment": "start"
          }
        }
      },
      "gap": "xs",
      "verticalAlignment": "center"
    }
  }
}
