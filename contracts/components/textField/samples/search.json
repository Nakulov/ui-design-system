{
  "TextField": {
    "id": "search",
    "layout": {
      "width": {
        "sizing": "fill"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "symmetric": {
        "horizontal": "m",
        "vertical": "s"
      }
    },
    "appearance": {
      "focusable": {
        "default": {
          "cornerRadius": "full",
          "stroke": {
            "width": "s",
            "color": "outline"
          }
        },
        "focused": {
          "cornerRadius": "full",
          "stroke": {
            "width": "m",
            "color": "primary"
          }
        },
        "disabled": {
          "background": {
            "solid": "surface2"
          },
          "cornerRadius": "full",
          "stroke": {
            "width": "s",
            "color": "outline"
          }
        }
      }
    },
    "events": [
      {
        "change": {
          "payload": {
            "action": "searchQueryChanged"
          }
        }
      },
      {
        "submit": {
          "payload": {
            "action": "search"
          }
        }
      }
    ],
    "typography": "bodyLarge",
    "color": {
      "default": {
        "solid": "onSurface"
      },
      "disabled": {
        "solid": "onSurfaceMuted"
      }
    },
    "alignment": "start",
    "cursorColor": "primary",
    "placeholder": {
      "content": {
        "plain": "Поиск"
      },
      "typography": "bodyLarge",
      "color": {
        "default": {
          "solid": "onSurfaceVariant"
        },
        "disabled": {
          "solid": "onSurfaceMuted"
        }
      }
    },
    "keyboard": {
      "returnKey": "search"
    },
    "clearButton": {
      "visibility": "whileNotEmpty",
      "gap": "s",
      "button": {
        "layout": {
          "width": {
            "sizing": "hug"
          },
          "height": {
            "sizing": "hug"
          },
          "position": "flow"
        },
        "padding": {
          "all": "zero"
        },
        "appearance": {
          "control": {
            "default": {
              "cornerRadius": "full"
            },
            "pressed": {
              "cornerRadius": "full",
              "overlay": {
                "solid": "overlayPressed"
              }
            },
            "disabled": {
              "cornerRadius": "full"
            }
          }
        },
        "states": {
          "default": {
            "Image": {
              "layout": {
                "width": {
                  "sizing": "hug"
                },
                "height": {
                  "sizing": "hug"
                },
                "position": "flow"
              },
              "padding": {
                "all": "zero"
              },
              "appearance": {
                "plain": {}
              },
              "source": {
                "resource": {
                  "icon": {
                    "name": "close",
                    "color": "onSurfaceVariant"
                  }
                }
              }
            }
          }
        }
      }
    },
    "leading": {
      "content": {
        "default": {
          "Image": {
            "id": "searchIcon",
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "source": {
              "resource": {
                "icon": {
                  "name": "search",
                  "color": "onSurfaceVariant"
                }
              }
            }
          }
        },
        "focused": {
          "Image": {
            "id": "searchIcon",
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "source": {
              "resource": {
                "icon": {
                  "name": "search",
                  "color": "onSurface"
                }
              }
            }
          }
        },
        "disabled": {
          "Image": {
            "id": "searchIcon",
            "layout": {
              "width": {
                "sizing": "hug"
              },
              "height": {
                "sizing": "hug"
              },
              "position": "flow"
            },
            "padding": {
              "all": "zero"
            },
            "appearance": {
              "plain": {}
            },
            "source": {
              "resource": {
                "icon": {
                  "name": "search",
                  "color": "onSurfaceMuted"
                }
              }
            }
          }
        }
      },
      "gap": "s",
      "verticalAlignment": "center"
    }
  }
}
