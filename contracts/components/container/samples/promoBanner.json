{
  "Container": {
    "layout": {
      "width": {
        "sizing": "fill"
      },
      "height": {
        "sizing": {
          "fixed": "xl3"
        }
      },
      "position": "flow"
    },
    "padding": {
      "all": "zero"
    },
    "appearance": {
      "plain": {
        "background": {
          "solid": "surface2"
        },
        "cornerRadius": "l",
        "clip": true
      }
    },
    "arrangement": {
      "overlay": {
        "horizontal": "start",
        "vertical": "bottom"
      }
    },
    "children": [
      {
        "Image": {
          "layout": {
            "width": {
              "sizing": "fill"
            },
            "height": {
              "sizing": "fill"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "source": {
            "remote": {
              "origin": {
                "url": "https://raw.githubusercontent.com/Nakulov/ui-design-system/dev/assets/images/banner.jpg"
              },
              "scale": "crop",
              "alignment": "center",
              "placeholder": {
                "icon": {
                  "name": "image",
                  "color": "onSurfaceMuted"
                }
              }
            }
          }
        }
      },
      {
        "Text": {
          "layout": {
            "width": {
              "sizing": "fill"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "l"
          },
          "appearance": {
            "plain": {}
          },
          "content": {
            "plain": "Осенняя распродажа"
          },
          "typography": "headlineSmall",
          "color": {
            "solid": "inverseOnSurface"
          },
          "alignment": "start"
        }
      }
    ]
  }
}
