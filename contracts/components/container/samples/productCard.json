{
  "Container": {
    "layout": {
      "width": {
        "sizing": "fill"
      },
      "height": {
        "sizing": "hug"
      },
      "position": "flow"
    },
    "padding": {
      "all": "m"
    },
    "appearance": {
      "plain": {
        "background": {
          "solid": "surface"
        },
        "shadow": "m",
        "cornerRadius": "l",
        "stroke": {
          "width": "s",
          "color": "outline"
        },
        "clip": true
      }
    },
    "events": [
      {
        "click": {
          "payload": {
            "action": "openProduct"
          }
        }
      }
    ],
    "arrangement": {
      "vertical": {
        "alignment": "start",
        "distribution": {
          "packed": {
            "gap": "s",
            "position": "top"
          }
        }
      }
    },
    "children": [
      {
        "Image": {
          "layout": {
            "width": {
              "sizing": "fill"
            },
            "height": {
              "sizing": {
                "fixed": "xl3"
              }
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {
              "background": {
                "solid": "surface2"
              },
              "cornerRadius": "m",
              "clip": true
            }
          },
          "source": {
            "remote": {
              "origin": {
                "url": "https://raw.githubusercontent.com/Nakulov/ui-design-system/dev/assets/images/product.jpg"
              },
              "scale": "crop",
              "alignment": "center",
              "placeholder": {
                "icon": {
                  "name": "image",
                  "color": "onSurfaceMuted"
                }
              },
              "error": {
                "icon": {
                  "name": "brokenImage",
                  "color": "onSurfaceMuted"
                }
              }
            }
          }
        }
      },
      {
        "Text": {
          "layout": {
            "width": {
              "sizing": "fill"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "content": {
            "plain": "Кружка керамическая, 350 мл"
          },
          "typography": "titleSmall",
          "color": {
            "solid": "onSurface"
          },
          "alignment": "start"
        }
      },
      {
        "Text": {
          "layout": {
            "width": {
              "sizing": "fill"
            },
            "height": {
              "sizing": "hug"
            },
            "position": "flow"
          },
          "padding": {
            "all": "zero"
          },
          "appearance": {
            "plain": {}
          },
          "content": {
            "plain": "1 490 ₽"
          },
          "typography": "labelLarge",
          "color": {
            "solid": "primary"
          },
          "alignment": "start"
        }
      },
      {
        "Image": {
          "id": "close",
          "layout": {
            "width": {
              "sizing": "hug"
            },
            "height": {
              "sizing": "hug"
            },
            "position": {
              "pinned": {
                "horizontal": {
                  "end": {
                    "offset": "s"
                  }
                },
                "vertical": {
                  "top": {
                    "offset": "s"
                  }
                },
                "relativeTo": "content"
              }
            }
          },
          "padding": {
            "all": "xs2"
          },
          "appearance": {
            "plain": {
              "background": {
                "solid": "surface"
              },
              "cornerRadius": "full"
            }
          },
          "events": [
            {
              "click": {
                "payload": {
                  "action": "dismiss"
                }
              }
            }
          ],
          "source": {
            "resource": {
              "icon": {
                "name": "close",
                "color": "onSurface"
              }
            }
          }
        }
      }
    ]
  }
}
